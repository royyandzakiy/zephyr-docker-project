# clangd configuration.
#
# Flags come from the compilation database CMake generates, not from a
# hand-maintained include list. Build once and the language server is correct:
#
#   west build -b native_sim -d build
#
# If you see "file not found" on <zephyr/...> headers, you have not built yet.
# To point the language server at a different target instead, change the
# CompilationDatabase path below (e.g. build_nrf53).

CompileFlags:
  CompilationDatabase: build

  Remove:
    # Flags that are right for the compiler but noisy or unsupported in clangd.
    - -Werror
    - -pedantic
    - -fno-reorder-functions
    - -fno-defer-pop
    - --param=min-pagesize=*
    - -mfp16-format=*

Diagnostics:
  # Zephyr headers pull in transitively-used symbols by design.
  UnusedIncludes: None
  MissingIncludes: None

Index:
  Background: Build
  StandardLibrary: true
