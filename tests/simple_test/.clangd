# /workspaces/zephyr-emul-project/tests/simple_test/.clangd
CompileFlags:
  Add:
    # Use --target (two dashes) not -target
    - --target=x86_64-unknown-linux-gnu
    - -D__ZEPHYR__=1
    - -DARCH_NATIVE=1
    - -D__ZEPHYR_SUPERVISOR__=1
    - -DCONFIG_ZTEST=1
    - -DZTEST=1
    - -DCONFIG_NATIVE_SIM=1
    - -D_GNU_SOURCE=1
    
    # Force C language mode (critical for tests)
    - -x
    - c
    
    # Test-specific includes
    - -I/workspaces/zephyr-emul-project/build_tests/zephyr/include/generated
    - -I/workspaces/zephyr-emul-project/build_tests/zephyr/include
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/include
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/include/zephyr
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/include/zephyr/arch/native
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/include/zephyr/arch
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/include/zephyr/sys
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/include/zephyr/kernel
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/subsys/testsuite/ztest/include
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/subsys/testsuite
    - -I/workdir/zephyr-sdks/v4.2.2/zephyr/subsys
    
    # Include the build directory for generated files
    - -I/workspaces/zephyr-emul-project/build_tests
    
    # Autoconf headers
    - -include
    - /workspaces/zephyr-emul-project/build_tests/zephyr/include/generated/autoconf.h
    
    # GNU extensions
    - -std=gnu11
    
    # Suppress warnings
    - -Wno-gnu-zero-variadic-macro-arguments
    - -Wno-language-extension-token
    - -Wno-unknown-warning-option
    - -Wno-unused-command-line-argument
    
  Remove:
    - -Werror
    - -pedantic
    - -std=c11
    - -std=c99

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  Suppress:
    - expected_either
    - pp_file_not_found
    - unknown_typename