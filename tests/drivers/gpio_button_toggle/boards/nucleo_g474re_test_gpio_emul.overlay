/ {
    /* Add emulated GPIO controller */
    emul_gpio: gpio_emul {
        compatible = "zephyr,gpio-emul";
        status = "okay";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <4>;
        
        interrupt-controller;
        #interrupt-cells = <2>;
        
        rising-edge;
        falling-edge;
        high-level;
        low-level;
    };

    buttons {
        compatible = "gpio-keys";
        button0: button_0 {
            gpios = <&emul_gpio 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Emulated Button";
        };
    };

    aliases {
        sw0 = &button0;
    };
};