# Test-tree overrides, merged on top of the repo-root .clangd.
#
# Twister builds each suite under twister-out/, which is throwaway and not a
# stable compilation database. Test sources therefore get their flags inferred
# from the nearest application entry in build/compile_commands.json, which is
# correct except that it lacks the ztest defines. Add them back here so
# ZTEST_SUITE / zassert_* resolve in the editor.

CompileFlags:
  Add:
    - -DCONFIG_ZTEST=1
    - -DZTEST=1
