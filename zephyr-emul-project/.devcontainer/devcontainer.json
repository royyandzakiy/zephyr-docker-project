{
  "name": "nRF Connect SDK Multi-Toolchain Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "customizations": {
    "vscode": {
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.arguments": [
          "--background-index",
          "--compile-commands-dir=${workspaceFolder}/build",
          "--header-insertion=iwyu"
        ]
      },
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "nordic-semiconductor.nrf-connect-extension-pack"
      ]
    }
  },
  "remoteUser": "root",
  "mounts": [
    "source=ncs-sdk-volume,target=/root/ncs,type=volume",
    "source=nrfutil-home-volume,target=/usr/local/share/nrfutil,type=volume"
  ],
  // One-liner: python script handles downloading missing SDK versions to volume
  "postStartCommand": "/usr/bin/python3 /workspaces/zephyr-emul-project/.devcontainer/ncs.py install v2.9.0 && /usr/bin/python3 /workspaces/zephyr-emul-project/.devcontainer/ncs.py install v3.3.0"
}